        },
        {
          "name": "detail",
          "type": "str",
          "default": "",
          "doc": ""
        }
      ]
    },
    {
      "event_type": "step_finished",
      "class": "StepFinished",
      "doc": "当前子任务收尾（模型给出了小结，或工具预算耗尽被强制叫停）。\n\n`cancelled` 表示这一步**根本没机会执行完**：重规划判定它做不成、把剩余步骤\n砍掉了，于是路由直接去收尾。它与 `budget_exhausted` 的区别是——后者是\"试过\n但工具轮次用完\"，前者是\"还没试就被放弃了\"。前端需要区分，否则用户会以为\n模型已经尝试过。",
      "fields": [
        {
          "name": "index",
          "type": "int",
          "default": 0,
          "doc": ""
        },
        {
          "name": "budget_exhausted",
          "type": "bool",
          "default": false,
          "doc": ""
        },
        {
          "name": "cancelled",
          "type": "bool",
          "default": false,
          "doc": ""
        },
        {
          "name": "text",
          "type": "str",
          "default": "",
          "doc": ""
        }
      ]
    },
    {
      "event_type": "step_started",
      "class": "StepStarted",
      "doc": "进入某个子任务。total == 1 时前端可不渲染步进标题。",
      "fields": [
        {
          "name": "index",
          "type": "int",
          "default": 0,
          "doc": ""
        },
        {
          "name": "total",
          "type": "int",
