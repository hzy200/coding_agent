          "name": "text",
          "type": "str",
          "default": "",
          "doc": ""
        }
      ]
    },
    {
      "event_type": "subagent_finished",
      "class": "SubAgentFinished",
      "doc": "子智能体结束。\n\n`status`: success / partial / failed / rejected。partial 表示跑满了轮次、超时，\n或报告生成失败但有兜底摘要 —— 主模型仍拿到可用信息，但不应把它当成完整结论。\nrejected 表示宿主没让它跑（审批拒绝、任务级委派预算耗尽），与「跑了但失败」不同。",
      "fields": [
        {
          "name": "agent_id",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "status",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "summary",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "relevant_files",
          "type": "list[str]",
          "default": "Field(default_factory=list)",
          "doc": ""
        },
        {
          "name": "findings",
          "type": "list[str]",
          "default": "Field(default_factory=list)",
          "doc": ""
        },
        {
          "name": "input_tokens",
          "type": "int",
          "default": 0,
          "doc": ""
        },
        {
          "name": "output_tokens",
          "type": "int",
          "default": 0,
          "doc": ""
        },
        {
          "name": "duration_ms",
          "type": "int",
          "default": 0,
          "doc": ""
        }
      ]
    },
    {
      "event_type": "subagent_started",
      "class": "SubAgentStarted",
      "doc": "主智能体把一次只读探索委派给了子智能体。\n\n与 `ToolCallStarted` 同时发出：delegate 本身也是一次工具调用。前端按\n`agent_id` 把后续的 `SubAgentFinished` 配对回来。",
      "fields": [
        {
          "name": "agent_id",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "parent_call_id",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "role",
          "type": "str",
          "default": "explore",
          "doc": ""
        },
        {
          "name": "goal",
          "type": "str",
          "default": "",
          "doc": ""
        }
      ]
    },
    {
      "event_type": "task_graph_created",
      "class": "TaskGraphCreated",
      "doc": "编排器生成了任务图（可能已降级为单任务）。",
      "fields": [
        {
          "name": "tasks",
          "type": "list[dict[str, Any]]",
          "default": "Field(default_factory=list)",
          "doc": ""
        },
        {
          "name": "degraded",
          "type": "bool",
          "default": false,
          "doc": ""
        }
      ]
    },
    {
      "event_type": "task_graph_extended",
      "class": "TaskGraphExtended",
      "doc": "运行中由 worker 提议、host 校验后追加的只读任务（Phase 4D）。",
      "fields": [
        {
          "name": "added",
          "type": "list[dict[str, Any]]",
          "default": "Field(default_factory=list)",
          "doc": ""
        },
        {
          "name": "rejected",
          "type": "list[str]",
          "default": "Field(default_factory=list)",
          "doc": ""
        }
      ]
    },
    {
      "event_type": "tool_call_finished",
      "class": "ToolCallFinished",
      "doc": "工具执行完毕。\n\nok/rejected 语义：rejected 表示被安全策略拦下（此时 exit_code 为 None）；\n两者都为 False 表示执行了但失败。文件工具没有退出码，exit_code 恒为 None。",
      "fields": [
        {
          "name": "call_id",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "name",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "ok",
          "type": "bool",
          "default": false,
          "doc": ""
        },
        {
          "name": "rejected",
          "type": "bool",
          "default": false,
          "doc": ""
        },
        {
          "name": "skipped",
          "type": "bool",
          "default": false,
          "doc": "环境不具备该能力（例如未配置 LSP）：不是成功，也不该计入失败率。"
        },
        {
          "name": "interrupted",
          "type": "bool",
          "default": false,
          "doc": "有副作用的调用执行到一半、结果未知：既不是成功也不是普通失败。"
        },
        {
          "name": "decision",
          "type": "str",
          "default": "auto",
          "doc": "auto / approved / denied / rejected —— 审计据此区分「谁拒的」"
        },
        {
          "name": "exit_code",
          "type": "int | None",
          "default": null,
          "doc": ""
        },
        {
          "name": "duration_ms",
          "type": "int | None",
          "default": null,
          "doc": ""
        },
        {
          "name": "level",
          "type": "str | None",
          "default": null,
          "doc": ""
        },
        {
          "name": "preview",
          "type": "str",
          "default": "",
          "doc": ""
        }
      ]
    },
    {
      "event_type": "tool_call_started",
      "class": "ToolCallStarted",
      "doc": "模型请求了一次工具调用，即将执行。\n\nlevel 供前端着色，不是安全判定。call_id 用于和 ToolCallFinished 配对 ——\n同一轮可能有多个并行工具调用，只靠顺序无法可靠对应。",
      "fields": [
        {
          "name": "call_id",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "name",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "args",
          "type": "dict[str, Any]",
          "default": "Field(default_factory=dict)",
          "doc": ""
        },
        {
          "name": "summary",
          "type": "str",
          "default": "",
          "doc": ""
        },
        {
          "name": "level",
          "type": "str | None",
          "default": null,
          "doc": ""
        }
      ]
    },
    {
      "event_type": "verification",
      "class": "Verification",
      "doc": "一步做完后自动跑验证的结果。\n\nstatus: ok / failed（跑过）、error（验证环境异常，没跑起来）、\nnot_configured（没有可用的测试命令）、skipped（没跑）。",
      "fields": [
        {
          "name": "status",
          "type": "str",
          "default": "skipped",
          "doc": ""
        },
