{
  "contract": "coding-agent/events",
  "version": 1,
  "source": "src/coding_agent/events.py",
  "note": "前端唯一可消费的领域事件契约。前端只认识这里的事件，不认识 LangGraph，也拿不到 tools/ 与 sandbox/。",
