    {
      "name": "wsl_health_check_enabled",
      "env": "AGENT_WSL_HEALTH_CHECK",
      "type": "bool",
      "default": true,
      "section": "通用",
      "doc": "WSL 健康检查与熔断。连续失败达到阈值后，短时间内直接 fail fast， 避免每个工具调用都去拉起一个注定失败的 wsl.exe；冷却后放一个探测请求。"
    },
