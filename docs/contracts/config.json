      "doc": "未配置 token 时是否允许 loopback 匿名访问（单用户本地模式）。"
    },
    {
      "name": "web_auth_tokens",
      "env": "AGENT_WEB_AUTH_TOKENS",
      "type": "str",
      "default": "",
      "section": "通用",
